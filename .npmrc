# Make package.json "engines.node" a hard requirement: `npm install`/`npm ci`
# fail on an unpatched Node instead of printing a warning. Pairs with
# scripts/check-node.mjs (the build-time guard). Added 2026-10-22 for the
# Node.js October 2026 security release (see docs/RUNBOOK.md 10).
engine-strict=true
